<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1848/CA1873: LoggerMessage delegates are not worth it for low-volume logs here.
         CA2007: ConfigureAwait is irrelevant in ASP.NET Core. CA1515: public types in apps are fine. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1515;CA1062;CA1031</NoWarn>
  </PropertyGroup>
</Project>
