# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Chat model used by the agents and embedding model used by the RAG pipeline.
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Service-to-service shared secrets (generate with: openssl rand -hex 32).
RAG_API_KEY=change-me-rag
MCP_API_KEY=change-me-mcp
